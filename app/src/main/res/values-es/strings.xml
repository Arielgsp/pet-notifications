    <string name="tut_taps_body">1 toque: te tiro corazones. 2 toques: salto. 3 toques: doy una vuelta.</string>
    <string name="tut_move_title">Llevame a donde quieras</string>
    <string name="tut_move_body">Arrastrame para cambiarme de lugar en la pantalla. Si me mantenés apretada, se abre la app.</string>
