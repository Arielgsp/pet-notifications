    <!-- Configuración guiada: la mascota habla en primera persona -->
    <string name="ob_step">Paso %1$d de %2$d</string>
    <string name="ob_welcome_title">¡Hola! Soy %1$s</string>
    <string name="ob_welcome_body">Voy a vivir en tu pantalla y avisarte de tus recordatorios y eventos. Antes, te explico los permisos que necesito, uno por uno. La app no tiene acceso a internet: tus datos nunca llegan a nosotros. Si querés, elegí otra mascota:</string>
    <string name="ob_start">Empezar</string>
    <string name="ob_skip">Saltear la configuración</string>
    <string name="ob_allow">Dar permiso</string>
    <string name="ob_connect">Conectar mi calendario</string>
    <string name="ob_open_settings">Abrir ajustes de la app</string>
    <string name="ob_not_now">Ahora no</string>
    <string name="ob_not_now_calendar">No, gracias</string>
    <string name="ob_overlay_title">Para estar siempre en tu pantalla</string>
    <string name="ob_overlay_body">Necesito el permiso “Mostrar sobre otras apps” para aparecer encima de lo que estés usando. Solo me dibujo a mí y a mis globos: no leo lo que hay en tu pantalla ni toco otras apps. En la pantalla que se abre, buscame en la lista y activá el permiso.</string>
    <string name="ob_overlay_no">Si decís que no: no me vas a ver, pero te aviso igual con notificaciones comunes.</string>
    <string name="ob_notif_title">Para avisarte con el celular bloqueado</string>
    <string name="ob_notif_body">Cuando la pantalla está apagada nadie me ve, así que te aviso con una notificación con sonido y los botones Aplazar y Listo.</string>
    <string name="ob_notif_no">Si decís que no: solo te aviso cuando estoy en pantalla y la tenés prendida.</string>
    <string name="ob_exact_title">Para avisarte justo a horario</string>
    <string name="ob_exact_body">Con “Alarmas y recordatorios” suenan a la hora exacta, aunque el celular esté en reposo. En la pantalla que se abre, activá el permiso.</string>
    <string name="ob_exact_no">Si decís que no: los avisos pueden llegar unos minutos tarde.</string>
    <string name="ob_calendar_title">¿Te aviso de tus eventos?</string>
    <string name="ob_calendar_body">Puedo leer los calendarios de tu celular, incluido Google Calendar de tu cuenta de Gmail, para avisarte de tus eventos. Solo leo; nunca cambio nada.</string>
    <string name="ob_calendar_no">Si decís que no: solo te aviso de los recordatorios que cargues en la app. Lo podés activar después en Ajustes.</string>
    <string name="ob_battery_title">Para que no me cierren</string>
    <string name="ob_battery_body">Algunos celulares cierran las apps para ahorrar batería y yo desaparezco. Seguí estos pasos para que no me cierren:</string>
    <string name="ob_battery_no">Si decís que no: puede que a veces desaparezca de la pantalla. Los avisos siguen llegando por notificación.</string>
    <string name="ob_done_title">¡Listo!</string>
    <string name="ob_done_body">Ya estoy en tu pantalla. Tocame, arrastrame o tocá “Probar un aviso” para ver cómo te aviso.</string>
    <string name="ob_done_body_no_overlay">Te voy a avisar con notificaciones. Si más adelante querés verme en pantalla, activá el permiso desde Ajustes › Permisos.</string>
    <string name="ob_finish">Ir a la app</string>

