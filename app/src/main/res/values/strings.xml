    <!-- Configuración guiada: la mascota habla en primera persona -->
    <string name="ob_step">Step %1$d of %2$d</string>
    <string name="ob_welcome_title">Hi! I am %1$s</string>
    <string name="ob_welcome_body">I will live on your screen and remind you of your reminders and events. First, let me explain the permissions I need, one by one. The app has no internet access: your data never reaches us. If you like, pick another pet:</string>
    <string name="ob_start">Start</string>
    <string name="ob_skip">Skip setup</string>
    <string name="ob_allow">Allow</string>
    <string name="ob_connect">Connect my calendar</string>
    <string name="ob_open_settings">Open app settings</string>
    <string name="ob_not_now">Not now</string>
    <string name="ob_not_now_calendar">No, thanks</string>
    <string name="ob_overlay_title">To always be on your screen</string>
    <string name="ob_overlay_body">I need the “Display over other apps” permission to appear on top of whatever you are using. I only draw myself and my bubbles: I do not read your screen or touch other apps. On the screen that opens, find me in the list and turn the permission on.</string>
    <string name="ob_overlay_no">If you say no: you will not see me, but I will still alert you with regular notifications.</string>
    <string name="ob_notif_title">To alert you when your phone is locked</string>
    <string name="ob_notif_body">When the screen is off nobody sees me, so I alert you with a notification with sound and the Later and Done buttons.</string>
    <string name="ob_notif_no">If you say no: I only alert you when I am on screen and it is on.</string>
    <string name="ob_exact_title">To alert you right on time</string>
    <string name="ob_exact_body">With “Alarms &amp; reminders” they go off at the exact time, even when the phone is idle. On the screen that opens, turn the permission on.</string>
    <string name="ob_exact_no">If you say no: alerts may arrive a few minutes late.</string>
    <string name="ob_calendar_title">Should I alert you about your events?</string>
    <string name="ob_calendar_body">I can read the calendars on your phone, including Google Calendar from your Gmail account, to alert you about your events. I only read; I never change anything.</string>
    <string name="ob_calendar_no">If you say no: I only alert you about reminders you add in the app. You can turn it on later in Settings.</string>
    <string name="ob_battery_title">So I do not get closed</string>
    <string name="ob_battery_body">Some phones close apps to save battery and I disappear. Follow these steps so I do not get closed:</string>
    <string name="ob_battery_no">If you say no: I may sometimes disappear from the screen. Alerts keep arriving as notifications.</string>
    <string name="ob_done_title">All set!</string>
    <string name="ob_done_body">I am on your screen now. Tap me, drag me, or tap “Try an alert” to see how I alert you.</string>
    <string name="ob_done_body_no_overlay">I will alert you with notifications. If you want to see me on screen later, turn on the permission in Settings › Permissions.</string>
    <string name="ob_finish">Go to the app</string>

