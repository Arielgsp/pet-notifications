    <!-- Tutorial de la mascota -->
    <string name="tut_header">What %1$s can do</string>
    <string name="tut_skip">Skip</string>
    <string name="tut_next">Next</string>
    <string name="tut_finish">Done</string>
    <string name="tut_open">What I can do</string>
    <string name="tut_open_sub">Gestures, alerts and how I look, animated</string>
    <string name="tut_taps_title">Tap me</string>
    <string name="tut_taps_body">1 tap: I send you hearts. 2 taps: I jump. 3 taps: I spin around.</string>
    <string name="tut_move_title">Take me anywhere</string>
    <string name="tut_move_body">Drag me to move me around the screen. Hold me to open the app.</string>
    <string name="tut_flicks_title">Quick flicks</string>
    <string name="tut_flicks_body">A flick is a short, fast swipe over me, like turning a page.</string>
    <string name="tut_flick_left">I show what is coming</string>
    <string name="tut_flick_down">You jot a quick reminder</string>
    <string name="tut_flick_up">I hide for 1 hour</string>
    <string name="tut_flick_right">I alert silently (flick again to undo)</string>
    <string name="tut_alert_title">When I alert you</string>
    <string name="tut_alert_body">I show up with a bubble and my sound. Tap Done if it is done, or Later and I will remind you again. If you do not answer, I insist for a while.</string>
    <string name="tut_sleep_title">I sleep too</string>
    <string name="tut_sleep_body">After 10 minutes without use I lie down to sleep, and during your Do not disturb hours I always sleep. Tap me or turn the screen on and I wake up. I still wake up if I have something to tell you.</string>
    <string name="tut_look_title">Change how I look</string>
    <string name="tut_look_body">In the Pet tab you can change my size and transparency (Pro). Ghost mode makes me see-through and your taps go through me, so you can use what is underneath.</string>
    <string name="tut_try_title">Try it yourself</string>
    <string name="tut_try_body">Tap me or flick me on the screen. While you are here nothing really happens: I just tell you which gesture you made.</string>
